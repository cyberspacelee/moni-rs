{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moni-rs",
  "main": "build/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "worker-build --release" },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    // 只有 API / WS 走 Worker，静态资源请求免费且不计入 Worker 请求数
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // Free 计划只能使用 SQLite 型 DO
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "vars": {
    "REPORT_INTERVAL_S": "2",
    "REPORT_IDLE_INTERVAL_S": "30",
    "RETENTION_MINUTE_DAYS": "7",
    "RETENTION_HOUR_DAYS": "90",
    "AGENT_RELEASE_REPO": "",
    // 允许未登录访客只读查看总览与历史（已脱敏）；设为 "false" 则整站需要登录
    "PUBLIC_DASHBOARD": "true"
  },
  "observability": { "enabled": true }
}
