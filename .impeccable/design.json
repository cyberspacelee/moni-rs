{
  "northStar": "The Quiet Instrument",
  "motion": {
    "meter-fill": {
      "duration": "500ms",
      "easing": "ease-out"
    },
    "control-color": {
      "duration": "150ms"
    }
  },
  "elevation": {
    "panel": "0 1px 2px rgb(20 20 19 / 0.04)",
    "card-hover": "0 8px 24px -12px rgb(20 20 19 / 0.18)",
    "tooltip": "0 8px 24px -8px rgb(0 0 0 / 0.25)"
  },
  "focus": {
    "ring": "3px var(--brand) at 15%",
    "border": "var(--brand)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "themes": {
    "dark": {
      "ground": "#1b1a19",
      "surface": "#242322",
      "ink": "#f4f3ee",
      "clay": "#d97757",
      "series-2": "#7fb0e0",
      "state-good": "#5cb87d",
      "state-warning": "#e0a83a",
      "state-critical": "#ec6b5e"
    }
  },
  "rules": [
    "State Words",
    "Words before icons",
    "No filler copy"
  ]
}