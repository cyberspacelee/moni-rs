{
  "northStar": "The Station Clock Network",
  "motion": {
    "clock-second-hand": { "duration": "320ms", "easing": "cubic-bezier(0.22, 1, 0.36, 1)", "reducedMotion": "none" },
    "meter-fill": { "duration": "500ms", "easing": "ease-out" },
    "control-color": { "duration": "150ms" }
  },
  "elevation": {
    "card-hover": "0 6px 20px -10px rgb(0 0 0 / 0.25)",
    "tooltip": "0 8px 24px -8px rgb(0 0 0 / 0.25)"
  },
  "focus": { "outline": "2px solid var(--brand)", "offset": "2px" },
  "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "themes": { "dark": { "shell": "#050505", "clock-face": "#ecebe6", "series-1": "#e4e3dd", "series-2": "#f0813f", "state-good": "#43c46a", "state-warning": "#e3ac33", "state-critical": "#f2668a" } },
  "rules": ["One Meaning", "Hollow Ring", "Numerals Only"]
}
